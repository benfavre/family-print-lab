# Family Print Lab settings. Copy this file to app/.env (ignored by Git) and restart the app.
# Everything here is optional: leave a section blank and that feature stays off.

# --- Lab assistant (Claude) ---------------------------------------------------
# An API key from https://console.anthropic.com. Or leave blank and run `ant auth login`.
# Each question sends workspace details (names, ages, projects, jobs, spools, printer status) to Anthropic.
ANTHROPIC_API_KEY=
# LAB_AI_MODEL=claude-opus-5
# LAB_AI=off

# --- Bambu Lab printer (read-only, local network) ------------------------------
# On the printer: Settings > WLAN/Network > LAN Mode Only, then Developer Mode.
BAMBU_HOST=
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=
# BAMBU_NAME=Bambu Lab X2D
