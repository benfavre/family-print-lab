# Family Print Lab configuration. Copy to .env (ignored by Git) and restart the app.
# Everything is optional; unset features stay off.

# --- Data --------------------------------------------------------------------------
# SQLite database file (created and migrated automatically).
DATABASE_URL=data/printlab.db
# Where automatic daily backups go (default: data/backups).
# BACKUP_DIR=data/backups
# On first start with an empty database, the previous app's family.json is imported from here.
# LEGACY_IMPORT=data/legacy/family.json

# --- Server ------------------------------------------------------------------------
# The production server (npm start) listens on this address. Keep 127.0.0.1 unless you
# deliberately expose it to your LAN, and then list the host names you will use.
HOST=127.0.0.1
PORT=8765
# ALLOWED_HOSTS=printlab.local,192.168.1.20
# Largest request the server accepts (model uploads are capped at 100 MB by the app itself).
BODY_SIZE_LIMIT=110M

# --- AI ------------------------------------------------------------------------------
# Choose providers per task in Settings. Subscriptions work through the official CLIs signed in on
# this computer: Claude Code (`claude`, then /login) and Codex (`codex login`). Found on PATH or
# ~/.local/bin; set these to use other locations. Keep this app single-user when using a subscription.
# CLAUDE_BIN=/home/you/.local/bin/claude
# CODEX_BIN=/usr/local/bin/codex
# Optional fallback: the Anthropic API with a key from https://console.anthropic.com (billed per use).
# Each question sends workspace details (names, ages, projects, jobs, spools, printer status) to the provider.
ANTHROPIC_API_KEY=
# LAB_AI_MODEL=claude-opus-5
# LAB_AI=off

# --- Bambu Lab printers (local network: status, upload, print control) -------------
# Add printers in the app: Integrations (Settings) > Printers > Add a printer, or Find printers.
# On each printer: Settings > WLAN/Network > LAN Mode Only, then Developer Mode.
# Older setups kept one printer here; it is imported into Settings once on first start (removing it
# in Settings later does not bring it back). BAMBU_MODEL is the Bambu model code (N6 = X2D, C12 = P1S,
# N1 = A1 mini…; see src/lib/shared/printers/models.ts), guessed from BAMBU_NAME when left out.
# BAMBU_HOST=
# BAMBU_SERIAL=
# BAMBU_ACCESS_CODE=
# BAMBU_NAME=Bambu Lab X2D
# BAMBU_MODEL=N6
# For development and tests only: a JSON list of printers registered (by serial) on every start,
# as `bun run dev:sim` does for its simulated fleet.
# PRINTLAB_PRINTERS=[{"name":"Sim X2D","model":"N6","host":"127.0.0.1","port":1883,"ftpPort":8990,"serial":"SIM-X2D-0001","accessCode":"12345678","tls":false,"simulated":true}]

# --- Print Lab Cloud (optional) ------------------------------------------------------
# Answer kids' print requests from a phone. Nothing is sent until you link on the Family page.
# What is shared and what the cloud may do: docs/cloud-protocol.md.
# The desktop app uses https://familyprintlab.app unless this is set (empty turns it off).
# CLOUD_URL=https://familyprintlab.app

# --- 3D models ------------------------------------------------------------------------
# Model files (one folder per model; default data/models next to the database).
# MODELS_DIR=data/models
# Blender for mesh repair/simplify and "Open in Blender" (default: ~/.local/opt/blender-*/blender, then PATH).
# BLENDER_PATH=/home/you/.local/opt/blender-5.2.2-linux-x64/blender

# --- Access from other devices (login) ---------------------------------------------
# This computer opens the app without a login. Other devices (when HOST or ALLOWED_HOSTS let them
# in) always log in, with a household password or a profile's own PIN: set them in the app,
# Integrations > Access from other devices. Until a password is set they see "Set a password on
# the computer first". "Require login here too" asks this computer as well.
# Forgot the password with "Require login here too" on? Start the app once with this set to 1: it
# removes the password and logs every device out. Then remove the line again.
# PRINTLAB_AUTH_RESET=1
