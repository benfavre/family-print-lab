From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Benjamin Favre <ben@webdesign29.net>
Date: Sun, 27 Sep 2026 11:15:50 +0000
Subject: [PATCH] G-code: capture the optional spiral processor without
 dereferencing it

Why: Constructing an unused pipeline filter binds a reference through a null optional spiral processor. Capture its pointer; both pipelines already invoke this filter only when the processor exists.

Files: src/libslic3r/GCode.cpp. Upstreamable: yes; corrects undefined behaviour independently of the facade, reproduced by strict sanitizer slice/export tests.

Co-Authored-By: Codex <noreply@openai.com>
---
 src/libslic3r/GCode.cpp | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/libslic3r/GCode.cpp b/src/libslic3r/GCode.cpp
index 6f8625f..ab66bad 100644
--- a/src/libslic3r/GCode.cpp
+++ b/src/libslic3r/GCode.cpp
@@ -3626,10 +3626,10 @@ void GCode::process_layers(
         this->m_spiral_vase->set_max_xy_smoothing(max_xy_smoothing);
     }
     const auto spiral_mode = tbb::make_filter<GCode::LayerResult, GCode::LayerResult>(
-        slic3r_tbb_filtermode::serial_in_order, [&spiral_mode = *this->m_spiral_vase.get(), & layers_to_print](GCode::LayerResult in) -> GCode::LayerResult {
-            spiral_mode.enable(in.spiral_vase_enable);
+        slic3r_tbb_filtermode::serial_in_order, [spiral_mode = this->m_spiral_vase.get(), & layers_to_print](GCode::LayerResult in) -> GCode::LayerResult {
+            spiral_mode->enable(in.spiral_vase_enable);
             bool last_layer = in.layer_id == layers_to_print.size() - 1;
-            return {spiral_mode.process_layer(std::move(in.gcode), last_layer), in.layer_id, in.spiral_vase_enable, in.cooling_buffer_flush, in.gcode_store_pos};
+            return {spiral_mode->process_layer(std::move(in.gcode), last_layer), in.layer_id, in.spiral_vase_enable, in.cooling_buffer_flush, in.gcode_store_pos};
         });
 
     std::vector<std::vector<PerExtruderAdjustments>> layers_extruder_adjustments(layers_to_print.size());
@@ -3765,10 +3765,10 @@ void GCode::process_layers(
         this->m_spiral_vase->set_max_xy_smoothing(max_xy_smoothing);
     }
     const auto spiral_mode = tbb::make_filter<GCode::LayerResult, GCode::LayerResult>(
-        slic3r_tbb_filtermode::serial_in_order, [&spiral_mode = *this->m_spiral_vase.get(), &layers_to_print](GCode::LayerResult in) -> GCode::LayerResult {
-            spiral_mode.enable(in.spiral_vase_enable);
+        slic3r_tbb_filtermode::serial_in_order, [spiral_mode = this->m_spiral_vase.get(), &layers_to_print](GCode::LayerResult in) -> GCode::LayerResult {
+            spiral_mode->enable(in.spiral_vase_enable);
             bool last_layer = in.layer_id == layers_to_print.size() - 1;
-            return {spiral_mode.process_layer(std::move(in.gcode), last_layer), in.layer_id, in.spiral_vase_enable, in.cooling_buffer_flush, in.gcode_store_pos};
+            return {spiral_mode->process_layer(std::move(in.gcode), last_layer), in.layer_id, in.spiral_vase_enable, in.cooling_buffer_flush, in.gcode_store_pos};
         });
 
     //BBS: get objects and nodes info, for better arrange
