-                    ConfigOptionBools * opt = this->option<ConfigOptionBools>(key);
+                    ConfigOptionVector<unsigned char> * opt = dynamic_cast<ConfigOptionVector<unsigned char>*>(this->option(key));
                     if (!opt) continue;
                     std::vector<unsigned char> new_values;
 
@@ -8861,7 +8861,7 @@ std::vector<int> DynamicPrintConfig::update_values_to_printer_extruders(DynamicP
                 }
                 case coEnums:
                 {
-                    ConfigOptionEnumsGeneric * opt = this->option<ConfigOptionEnumsGeneric>(key);
+                    ConfigOptionVector<int> * opt = dynamic_cast<ConfigOptionVector<int>*>(this->option(key));
                     if (!opt) continue;
