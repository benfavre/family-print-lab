# Local secrets and device access details
.env
.env.*
!.env.example
secrets/
private/
*.pem
*.key

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*~

# Local family app data
app/data/
app/node_modules/

# Tokens and one-off security work stay out of history
*.token
security-review-*/

# Python bytecode (Blender scripts)
__pycache__/
*.pyc

# Parity programme: upstream Bambu Studio checkout, slicer engine build output and bundles,
# downloaded upstream resources (profiles, HMS, printers)
app/resources/bambu/
slicer/.upstream/
slicer/.build/
slicer/dist/
desktop/server/engine/
# Bambu printer CA certificates are public and ship with the app
!app/src/lib/server/printer/certs/*.pem
